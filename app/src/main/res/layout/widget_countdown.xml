<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wcd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_round">

    <TextView
        android:id="@+id/wcd_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_main"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/wcd_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/wcd_days"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="@color/widget_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wcd_reshoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="重新选择事件"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp"
        android:paddingTop="4dp" />
</LinearLayout>
